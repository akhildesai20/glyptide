{
  "name": "@glyptide/react",
  "version": "0.1.0",
  "description": "React adapter for Glyptide text motion patterns",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "glyptide": "^0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "glyptide": "file:../glyptide",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "happy-dom": "^21.0.4"
  },
  "keywords": [
    "glyptide",
    "react",
    "streaming",
    "generative-ui",
    "animation",
    "text"
  ],
  "license": "MIT",
  "author": "Glyptide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhildesai20/glyptide.git",
    "directory": "packages/glyptide-react"
  },
  "bugs": {
    "url": "https://github.com/akhildesai20/glyptide/issues"
  },
  "homepage": "https://github.com/akhildesai20/glyptide#readme",
  "engines": {
    "node": ">=18"
  }
}
